{
 "title": "Bathroom",
 "path": "room-bathroom",
 "icon": "mdi:shower",
 "type": "custom:grid-layout",
 "background": "radial-gradient(120% 60% at 0% 0%, rgba(120,88,52,0.30) 0%, rgba(11,11,13,0) 55%), radial-gradient(90% 40% at 100% 100%, rgba(90,70,45,0.14) 0%, rgba(11,11,13,0) 60%), #0B0B0D",
 "layout": {
  "grid-template-columns": "repeat(2, minmax(0, 312px))",
  "grid-gap": "16px",
  "padding": "44px 40px 140px",
  "margin": 0,
  "place-content": "start center",
  "height": "auto"
 },
 "cards": [
  {
   "type": "custom:button-card",
   "template": "wm_room_head",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "triggers_update": [
    "light.bathroom_light"
   ],
   "variables": {
    "title": "Bathroom",
    "icon": "mdi:shower",
    "subtitle": "[[[ const parts = []; const ts = states['none']; const tv = ts ? parseFloat(ts.entity_id.startsWith('weather.') ? ts.attributes.temperature : ts.state) : NaN; if (!isNaN(tv)) parts.push(Math.round(tv) + '°'); const hs = states['none']; const hv = hs ? parseFloat(hs.state) : NaN; if (!isNaN(hv)) parts.push(Math.round(hv) + '% humidity'); const ids = ['light.bathroom_light']; const n = ids.filter(i => states[i] && states[i].state === 'on').length; if (ids.length) parts.push(n ? `<span style='color:#FFDC96'>${n} light${n > 1 ? 's' : ''} on</span>` : 'Lights off'); return parts.length ? parts.join(' · ') : 'Nothing set up here yet'; ]]]"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Lights"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_tile",
   "entity": "light.bathroom_light",
   "variables": {
    "name": "Bathroom",
    "icon": "mdi:ceiling-light-outline"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Sensors"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_text_tile",
   "entity": "binary_sensor.bathroom_motion_sensor_occupancy",
   "triggers_update": [],
   "variables": {
    "name": "Motion",
    "icon": "mdi:motion-sensor",
    "text": "[[[ return entity && entity.state === 'on' ? 'Someone is here' : 'Clear'; ]]]",
    "tone": "[[[ return entity && entity.state === 'on' ? 'mint' : 'none'; ]]]"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_nav",
   "view_layout": {
    "grid-column": "1 / -1"
   }
  }
 ]
}