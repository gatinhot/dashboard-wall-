{
 "title": "Home",
 "path": "home",
 "icon": "mdi:home-outline",
 "type": "custom:grid-layout",
 "background": "radial-gradient(120% 60% at 0% 0%, rgba(120,88,52,0.30) 0%, rgba(11,11,13,0) 55%), radial-gradient(90% 40% at 100% 100%, rgba(90,70,45,0.14) 0%, rgba(11,11,13,0) 60%), #0B0B0D",
 "layout": {
  "grid-template-columns": "minmax(0, 640px)",
  "grid-template-areas": "\"header\" \"greet\" \"quick\" \"tabs\" \"rooms\" \"nav\"",
  "grid-template-rows": "auto auto auto 56px minmax(548px, auto) 70px",
  "grid-gap": "20px",
  "padding": "40px 40px 40px",
  "margin": 0,
  "place-content": "start center",
  "height": "auto"
 },
 "cards": [
  {
   "type": "custom:button-card",
   "template": "wm_header",
   "view_layout": {
    "grid-area": "header"
   },
   "triggers_update": [
    "weather.forecast_t_c_homeassistant",
    "sensor.date"
   ]
  },
  {
   "type": "custom:button-card",
   "template": "wm_greeting",
   "view_layout": {
    "grid-area": "greet"
   }
  },
  {
   "type": "horizontal-stack",
   "view_layout": {
    "grid-area": "quick"
   },
   "cards": [
    {
     "type": "custom:button-card",
     "template": "wm_quick",
     "entity": "sensor.shelly_main_power_meter_channel_1_power",
     "name": "Energy",
     "triggers_update": [
      "input_number.energy_high_usage_from"
     ],
     "variables": {
      "icon": "mdi:leaf",
      "role": "[[[ const lim = parseFloat(states['input_number.energy_high_usage_from']?.state);\n    const v = parseFloat(entity?.state);\n    return (!isNaN(lim) && v >= lim) ? 'peach' : 'none'; ]]]\n"
     },
     "tap_action": {
      "action": "navigate",
      "navigation_path": "/11-west-mead-wall-beta/energy"
     }
    },
    {
     "entity": "climate.living_room",
     "name": "Climate",
     "tap_action": {
      "action": "navigate",
      "haptic": "light",
      "navigation_path": "/11-west-mead-wall-beta/climate"
     },
     "template": "wm_quick",
     "triggers_update": [
      "climate.office_ac"
     ],
     "type": "custom:button-card",
     "variables": {
      "icon": "mdi:home-thermometer-outline",
      "role": "[[[ const act = (s => s ? (s.attributes.hvac_action || ({heat: 'heating', cool: 'cooling', dry: 'drying', fan_only: 'fan', heat_cool: 'auto', auto: 'auto'})[s.state] || null) : null); const a = ['climate.living_room', 'climate.office_ac'].map(i => act(states[i])); return a.includes('heating') ? 'coral' : a.some(x => ['cooling', 'auto', 'drying', 'fan'].includes(x)) ? 'mint' : 'none'; ]]]"
     }
    },
    {
     "type": "custom:button-card",
     "template": "wm_quick",
     "entity": "sensor.wr67xfs_lock",
     "name": "Car",
     "triggers_update": [
      "sensor.wr67xfs_fuel_level"
     ],
     "variables": {
      "icon": "mdi:car-outline",
      "badge": "[[[ const locked = ['1', '2'].includes(entity?.state);\n    const fuel = parseFloat(states['sensor.wr67xfs_fuel_level']?.state);\n    return !locked ? 'coral' : (!isNaN(fuel) && fuel < 15) ? 'peach' : 'none'; ]]]\n"
     },
     "tap_action": {
      "action": "navigate",
      "navigation_path": "/11-west-mead-wall-beta/safety"
     }
    },
    {
     "type": "custom:button-card",
     "template": "wm_quick",
     "entity": "light.all_house_lights",
     "name": "Lights",
     "variables": {
      "icon": "mdi:lightbulb-outline",
      "role": "[[[ const rg = ['light.living_room_lights_all', 'light.kitchen_lights_all', 'light.bedroom_lights_all', 'light.bathroom_lights', 'light.office_lights_all', 'light.anexo_lights_all', 'light.storage_lights_all']; const og = ['light.garden_lights_all', 'light.lights_shed_all']; const groups = states['input_boolean.lights_include_outside']?.state === 'off' ? rg : rg.concat(og); const seen = new Set(); const walk = id => { if (seen.has(id)) return; seen.add(id); (states[id]?.attributes?.entity_id || []).forEach(walk); }; groups.forEach(walk); const n = [...seen].filter(id => !states[id]?.attributes?.entity_id && states[id]?.state === 'on').length; return n ? 'gold' : 'none'; ]]]"
     },
     "tap_action": {
      "action": "navigate",
      "navigation_path": "/11-west-mead-wall-beta/lights",
      "haptic": "light"
     },
     "triggers_update": [
      "light.living_room_lights_all",
      "light.kitchen_lights_all",
      "light.bedroom_lights_all",
      "light.bathroom_lights",
      "light.office_lights_all",
      "light.anexo_lights_all",
      "light.storage_lights_all",
      "light.garden_lights_all",
      "light.lights_shed_all",
      "input_boolean.lights_include_outside"
     ],
     "double_tap_action": {
      "action": "perform-action",
      "perform_action": "light.turn_off",
      "target": {
       "entity_id": "[[[ const rg = ['light.living_room_lights_all', 'light.kitchen_lights_all', 'light.bedroom_lights_all', 'light.bathroom_lights', 'light.office_lights_all', 'light.anexo_lights_all', 'light.storage_lights_all']; const og = ['light.garden_lights_all', 'light.lights_shed_all']; const groups = states['input_boolean.lights_include_outside']?.state === 'off' ? rg : rg.concat(og); return groups; ]]]"
      },
      "haptic": "heavy"
     }
    }
   ]
  },
