{
 "title": "Living room",
 "path": "room-living-room",
 "icon": "mdi:sofa-outline",
 "type": "custom:grid-layout",
 "background": "radial-gradient(120% 60% at 0% 0%, rgba(120,88,52,0.30) 0%, rgba(11,11,13,0) 55%), radial-gradient(90% 40% at 100% 100%, rgba(90,70,45,0.14) 0%, rgba(11,11,13,0) 60%), #0B0B0D",
 "layout": {
  "grid-template-columns": "repeat(2, minmax(0, 312px))",
  "grid-gap": "16px",
  "padding": "44px 40px 140px",
  "margin": 0,
  "place-content": "start center",
  "height": "auto"
 },
 "cards": [
  {
   "type": "custom:button-card",
   "template": "wm_room_head",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "triggers_update": [
    "light.livingroom_light_readinglamp",
    "light.living_room_cabinet",
    "light.wled_tvlight",
    "light.livingroom_light_sticks",
    "light.ginger_light",
    "sensor.living_room_temperature",
    "sensor.living_room_humidity"
   ],
   "variables": {
    "title": "Living room",
    "icon": "mdi:sofa-outline",
    "subtitle": "[[[ const parts = []; const ts = states['sensor.living_room_temperature']; const tv = ts ? parseFloat(ts.entity_id.startsWith('weather.') ? ts.attributes.temperature : ts.state) : NaN; if (!isNaN(tv)) parts.push(Math.round(tv) + '°'); const hs = states['sensor.living_room_humidity']; const hv = hs ? parseFloat(hs.state) : NaN; if (!isNaN(hv)) parts.push(Math.round(hv) + '% humidity'); const ids = ['light.livingroom_light_readinglamp', 'light.living_room_cabinet', 'light.wled_tvlight', 'light.livingroom_light_sticks', 'light.ginger_light']; const n = ids.filter(i => states[i] && states[i].state === 'on').length; if (ids.length) parts.push(n ? `<span style='color:#FFDC96'>${n} light${n > 1 ? 's' : ''} on</span>` : 'Lights off'); return parts.length ? parts.join(' · ') : 'Nothing set up here yet'; ]]]"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Lights"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_dim",
   "entity": "light.livingroom_light_readinglamp",
   "variables": {
    "name": "Reading lamp",
    "icon": "mdi:floor-lamp-outline"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_dim",
   "entity": "light.living_room_cabinet",
   "variables": {
    "name": "Cabinet",
    "icon": "mdi:led-strip-variant"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_dim",
   "entity": "light.wled_tvlight",
   "variables": {
    "name": "TV light",
    "icon": "mdi:television-ambient-light"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_tile",
   "entity": "light.livingroom_light_sticks",
   "variables": {
    "name": "Light sticks",
    "icon": "mdi:lightbulb-group-outline"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_dim",
   "entity": "light.ginger_light",
   "variables": {
    "name": "Ginger light",
    "icon": "mdi:dog"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Climate"
   }
  },
  {
   "custom_fields": {
    "modes": {
     "card": {
      "cards": [
       {
        "entity": "climate.living_room",
        "template": "wm_hvac_seg",
        "type": "custom:button-card",
        "variables": {
         "label": "Heat",
         "mode": "heat"
        }
       },
       {
        "entity": "climate.living_room",
        "template": "wm_hvac_seg",
        "type": "custom:button-card",
        "variables": {
         "label": "Off",
         "mode": "off"
        }
       }
      ],
      "type": "horizontal-stack"
     }
    }
   },
   "entity": "climate.living_room",
   "template": "wm_climate",
   "triggers_update": [
    "sensor.living_room_temperature",
    "sensor.living_room_humidity"
   ],
   "type": "custom:button-card",
   "variables": {
    "humidity": "sensor.living_room_humidity",
    "icon": "mdi:sofa-outline",
    "name": "Living room",
    "temp": "sensor.living_room_temperature"
   },
   "view_layout": {
    "grid-column": "1 / -1"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
