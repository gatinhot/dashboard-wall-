{
 "title": "Kitchen",
 "path": "room-kitchen",
 "icon": "mdi:pot-steam-outline",
 "type": "custom:grid-layout",
 "background": "radial-gradient(120% 60% at 0% 0%, rgba(120,88,52,0.30) 0%, rgba(11,11,13,0) 55%), radial-gradient(90% 40% at 100% 100%, rgba(90,70,45,0.14) 0%, rgba(11,11,13,0) 60%), #0B0B0D",
 "layout": {
  "grid-template-columns": "repeat(2, minmax(0, 312px))",
  "grid-gap": "16px",
  "padding": "44px 40px 140px",
  "margin": 0,
  "place-content": "start center",
  "height": "auto"
 },
 "cards": [
  {
   "type": "custom:button-card",
   "template": "wm_room_head",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "triggers_update": [
    "light.controller_rgb_ir_96b26b",
    "sensor.kitchen_presence_multi_sensor_fp300_testing_temperature",
    "sensor.kitchen_presence_multi_sensor_fp300_testing_humidity"
   ],
   "variables": {
    "title": "Kitchen",
    "icon": "mdi:pot-steam-outline",
    "subtitle": "[[[ const parts = []; const ts = states['sensor.kitchen_presence_multi_sensor_fp300_testing_temperature']; const tv = ts ? parseFloat(ts.entity_id.startsWith('weather.') ? ts.attributes.temperature : ts.state) : NaN; if (!isNaN(tv)) parts.push(Math.round(tv) + '°'); const hs = states['sensor.kitchen_presence_multi_sensor_fp300_testing_humidity']; const hv = hs ? parseFloat(hs.state) : NaN; if (!isNaN(hv)) parts.push(Math.round(hv) + '% humidity'); const ids = ['light.controller_rgb_ir_96b26b']; const n = ids.filter(i => states[i] && states[i].state === 'on').length; if (ids.length) parts.push(n ? `<span style='color:#FFDC96'>${n} light${n > 1 ? 's' : ''} on</span>` : 'Lights off'); return parts.length ? parts.join(' · ') : 'Nothing set up here yet'; ]]]"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Lights"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_light_dim",
   "entity": "light.controller_rgb_ir_96b26b",
   "variables": {
    "name": "Kitchen counter",
    "icon": "mdi:led-strip-variant"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Music"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_media_room",
   "entity": "media_player.kitchen_display_2",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "name": "Kitchen display"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Scenes"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_scene_tile",
   "entity": "scene.kitchen_evening",
   "variables": {
    "name": "Evening",
    "icon": "mdi:weather-night"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_label",
   "view_layout": {
    "grid-column": "1 / -1"
   },
   "variables": {
    "text": "Sensors"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_status_tile",
   "entity": "binary_sensor.kitchen_sensor_window",
   "variables": {
    "name": "Window",
    "icon": "mdi:window-closed-variant"
   }
  },
  {
   "type": "custom:button-card",
   "template": "wm_nav",
   "view_layout": {
    "grid-column": "1 / -1"
   }
  }
 ]
}