    "light.office_light_ceiling",
    "light.office_lamp_up",
    "light.office_lamp_child",
    "sensor.office_temperature"
   ],
   "variables": {
    "title": "Office one",
    "icon": "mdi:desktop-tower-monitor",
    "subtitle": "[[[ const parts = []; const ts = states['sensor.office_temperature']; const tv = ts ? parseFloat(ts.entity_id.startsWith('weather.') ? ts.attributes.temperature : ts.state) : NaN; if (!isNaN(tv)) parts.push(Math.round(tv) + '°'); const hs = states['none']; const hv = hs ? parseFloat(hs.state) : NaN; if (!isNaN(hv)) parts.push(Math.round(hv) + '% humidity'); const ids = ['light.office_light_ceiling', 'light.office_lamp_up', 'light.office_lamp_child']; const n = ids.filter(i => states[i] && states[i].state === 'on').length; if (ids.length) parts.push(n ? `<span style='color:#FFDC96'>${n} light${n > 1 ? 's' : ''} on</span>` : 'Lights off'); return parts.length ? parts.join(' · ') : 'Nothing set up here yet'; ]]]"
   }
